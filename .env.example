# Eddie configuration. Copy to .env (git-ignored) for local overrides.
# Every default below is the SAFE default: $0, offline, no live calls.

# --- Backend ---------------------------------------------------------------
# mock (default, $0 deterministic) | dgx (local OpenAI-compatible server, $0) | ember (paid)
EDDIE_BACKEND=mock

# Second, independent switch. Live Ember calls are refused unless this is exactly "true"
# AND the ledger is anchored (python -m eddie.cli budget init) AND a key file exists.
EDDIE_ALLOW_LIVE_EMBER=false

# The Ember key is read ONLY from this file (mode 600), never from the repo.
# Never put the key itself in this file or in any container environment.
META_API_KEY_FILE=~/.secrets/eddie/meta_api_key

# --- Spend governor (code ceilings: lifetime $9.00, run $2.00) -------------------
# Lifetime cap: proposed at `budget init`, then persisted in the ledger. Env can only lower it.
EDDIE_LIFETIME_CAP_USD=8.00
# Per-process cap. Above $0.10 it needs EDDIE_RUN_CAP_CONFIRM=<amount>:<YYYY-MM-DD> (today only).
EDDIE_RUN_CAP_USD=0.10
EDDIE_RUN_CAP_CONFIRM=
# Rolling 24 h cap. Above $2.00 it needs EDDIE_DAILY_CAP_CONFIRM=<amount>:<YYYY-MM-DD>.
EDDIE_DAILY_CAP_USD=2.00
EDDIE_DAILY_CAP_CONFIRM=
# Concurrent in-flight Ember requests across all processes (1..16).
EDDIE_MAX_CONCURRENCY=4

# --- Paths (defaults shown) ------------------------------------------------------
# EDDIE_LEDGER_PATH=~/.local/share/eddie/ledger.sqlite
# EDDIE_PUBLIC_DIR=~/.local/share/eddie/public
# EDDIE_DATA_DIR=./data
# EDDIE_SHADOW_LEDGER_PATH=./data/shadow.sqlite
# EDDIE_INDEX_PATH=./data/index/eddie_index.sqlite

# --- DGX local inference (OpenAI-compatible /v1/chat/completions) ----------------
# Leave empty until a gateway tenant exists; dgx mode refuses to run unconfigured.
DGX_TEXT_BASE_URL=
DGX_TEXT_MODEL=gemma4-prod:20260910
DGX_VISION_BASE_URL=
DGX_VISION_MODEL=gemma4-prod:20260910
# Bearer token file for the DGX gateway (mode 600).
DGX_API_KEY_FILE=
