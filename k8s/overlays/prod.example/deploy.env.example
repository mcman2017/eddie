# Copy to k8s/overlays/prod/deploy.env (git-ignored) with `scripts/deploy_prod.sh init`,
# fill in the real values there, then `scripts/deploy_prod.sh check`.
KUBE_CONTEXT=your-kube-context
NAMESPACE=eddie
HOST=eddie.example.com
IMAGE_REPO=registry.example.com/eddie
IMAGE_TAG=
PULL_SECRET=registry-secret
PULL_SECRET_FROM_NS=a-namespace-that-has-it
STORAGE_CLASS=standard
PVC_SIZE=5Gi
CLUSTER_ISSUER=letsencrypt-prod
# Basic Auth at the ingress while the site is private; unlock_public_submission.sh sets it to off.
AUTH=on
AUTH_USER=preview
AUTH_REALM="Eddie preview"
# Cloudflare-friendly `public` cache headers; turned on by the unlock (never behind Basic Auth).
PUBLIC_CACHE=0
# Optional: an annotation that keeps an automated image patcher away from the Deployment.
IMAGE_PATCH_SKIP_ANNOTATION=
