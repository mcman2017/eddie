# Eddie's default plot style: ink on a white card. Every sandboxed script gets it through
# MATPLOTLIBRC. Rendered from eddie/sandbox/style.py (rc_text); do not edit by hand.
# A '#' starts a comment in this format, so colours are written without it.
figure.facecolor:   FFFFFF
axes.facecolor:     FFFFFF
savefig.facecolor:  FFFFFF
figure.figsize:     6.4, 3.8
figure.dpi:         200
text.color:         18181B
axes.labelcolor:    44403C
xtick.color:        6B645C
ytick.color:        6B645C
axes.edgecolor:     CFC8BA
axes.grid:          True
axes.axisbelow:     True
grid.color:         E2DDD3
grid.linewidth:     0.6
axes.spines.top:    False
axes.spines.right:  False
legend.frameon:     False
font.size:          11
axes.titlesize:     13
axes.titleweight:   bold
axes.titlelocation: left
axes.prop_cycle:    cycler('color', ['1D3FBF', 'D9480F', 'D946EF', '099268'])
lines.linewidth:    1.8
